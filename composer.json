{
    "name": "letterncms/docs",
    "description": "The documentation site.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.1 <1",
        "letterncms/analytics": ">=0.1 <1",
        "letterncms/assistant": ">=0.1 <1",
        "letterncms/blocks": ">=0.1 <1",
        "letterncms/brevo": ">=0.1 <1",
        "letterncms/collab": ">=0.1 <1",
        "letterncms/forms": ">=0.1 <1",
        "letterncms/i18n": ">=0.1 <1",
        "letterncms/mail": ">=0.1 <1",
        "letterncms/mcp": ">=0.1 <1",
        "letterncms/media": ">=0.1 <1",
        "letterncms/navigation": ">=0.1 <1",
        "letterncms/seo": ">=0.1 <1",
        "letterncms/site": ">=0.1 <1"
    },
    "config": {
        "allow-plugins": {
            "letterncms/composer-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
