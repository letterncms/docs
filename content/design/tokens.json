                "$value": {
                    "min": "1.25rem",
                    "max": "2.5rem"
                }
            },
            "section": {
                "$value": {
                    "min": "4.5rem",
                    "max": "8.5rem"
                }
            },
            "5": {
                "$value": "1.25rem"
            },
            "10": {
                "$value": "2.5rem"
            },
            "20": {
                "$value": "5rem"
            },
            "32": {
                "$value": "8rem"
            }
        },
        "radius": {
            "none": {
                "$value": "0"
            },
            "sm": {
                "$value": "0.375rem"
            },
            "md": {
                "$value": "0.5rem"
            },
            "lg": {
                "$value": "0.625rem"
            },
            "full": {
                "$value": "9999px"
            },
            "xl": {
                "$value": "0.875rem"
            }
        },
        "shadow": {
            "sm": {
                "$value": "0 1px 2px rgb(43 41 38 / 0.05)"
            },
            "md": {
                "$value": "0 4px 12px rgb(43 41 38 / 0.06)"
            },
            "lg": {
                "$value": "0 8px 24px rgb(43 41 38 / 0.07)"
            },
            "xl": {
                "$value": "0 12px 32px rgb(43 41 38 / 0.08)"
            }
        },
        "container": {
            "prose": {
                "$value": "40rem"
            },
            "content": {
                "$value": "76rem"
            },
            "wide": {
                "$value": "90rem"
            }
        },
        "control": {
            "$type": "dimension",
            "sm-height": {
                "$value": "2rem"
            },
            "sm-padding": {
                "$value": "0.75rem"
            },
            "sm-text": {
                "$value": "token:text.sm"
            },
            "md-height": {
                "$value": "2.25rem"
            },
            "md-padding": {
                "$value": "0.875rem"
            },
            "md-text": {
                "$value": "token:text.sm"
            },
            "lg-height": {
                "$value": "3rem"
            },
            "lg-padding": {
                "$value": "1rem"
            },
            "lg-text": {
                "$value": "token:text.base"
            }
        },
