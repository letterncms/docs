            "fast": {
                "$value": "150ms"
            },
            "base": {
                "$value": "300ms"
            },
            "slow": {
                "$value": "700ms"
            }
        },
        "ease": {
            "out": {
                "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)"
            },
            "expo": {
                "$value": "cubic-bezier(0.16, 1, 0.3, 1)"
            },
            "in-out": {
                "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
            }
        }
    },
    "fonts": [
        {
            "family": "Inter",
            "src": "fonts/inter.woff2",
            "weight": "400 600",
            "style": "normal",
            "preload": true
        },
        {
            "family": "Geist Mono",
            "src": "fonts/GeistMono-Variable.woff2",
            "weight": "100 900",
            "style": "normal"
        }
    ],
    "styles": {
        "body": {
            "fontFamily": "token:font.sans",
            "fontSize": "token:text.base",
            "lineHeight": "token:leading.normal",
            "letterSpacing": "token:tracking.normal",
            "color": "token:color.foreground",
            "backgroundColor": "token:color.background",
            "WebkitFontSmoothing": "antialiased"
        },
        "h1": {
            "fontSize": "token:text.5xl",
            "lineHeight": "token:leading.display",
            "letterSpacing": "token:tracking.display",
            "fontWeight": "token:weight.heading",
            "color": "token:color.ink",
            "textWrap": "balance"
        },
        "h2": {
            "fontSize": "token:text.2xl",
            "lineHeight": "token:leading.tight",
            "letterSpacing": "token:tracking.tight",
            "fontWeight": "token:weight.heading",
            "color": "token:color.ink",
            "textWrap": "balance"
        },
        "h3": {
            "fontSize": "token:text.base",
            "lineHeight": "token:leading.normal",
            "letterSpacing": "token:tracking.normal",
            "fontWeight": "token:weight.heading",
            "color": "token:color.ink"
        },
        "a": {
            "color": "inherit",
            "textUnderlineOffset": "0.2em",
            "textDecorationColor": "token:color.line-strong"
        },
        "code": {
            "fontFamily": "token:font.mono",
            "fontSize": "0.875em",
            "letterSpacing": "0"
        },
        "kbd": {
            "fontFamily": "token:font.mono",
            "fontSize": "0.8em"
        },
        "::selection": {
            "backgroundColor": "token:color.yellow",
            "color": "token:color.black"
        },
        "p": {
            "textWrap": "pretty"
        },
        "h1 em": {
            "fontStyle": "normal"
        },
        "h2 em": {
            "fontStyle": "normal"
        },
        ":focus-visible": {
            "outline": "2px solid var(--color-focus)",
            "outlineOffset": "3px"
        }
    },
    "prose": {
        "p": {
            "lineHeight": "1.6"
        },
        "li": {
            "lineHeight": "1.6"
        },
        "h2": {
            "marginTop": "2.75rem",
            "marginBottom": "0"
        },
        "h3": {
            "fontSize": "token:text.lg",
            "lineHeight": "1.4",
            "marginTop": "2rem"
        },
        "h4": {
            "marginTop": "1.5rem",
            "fontSize": "token:text.base",
            "fontWeight": "token:weight.medium",
            "color": "token:color.ink"
        },
        "a": {
            "color": "token:color.ink",
            "textDecoration": "underline",
            "textDecorationThickness": "2px",
            "textDecorationColor": "token:color.yellow",
            "textUnderlineOffset": "0.18em"
        },
        "a:hover": {
            "textDecorationColor": "token:color.ink"
        },
        "strong": {
            "fontWeight": "token:weight.medium",
            "color": "token:color.ink"
        },
        "ul": {
            "paddingLeft": "1.25rem"
        },
        "ol": {
            "paddingLeft": "1.25rem"
        },
        "blockquote": {
            "paddingLeft": "1rem",
            "borderLeft": "2px solid token:color.line-strong",
            "color": "token:color.muted"
        },
        "hr": {
            "borderTop": "1px solid token:color.line",
            "marginBlock": "2.5rem"
        },
        "img": {
            "boxShadow": "0 0 0 1px token:color.border",
            "borderRadius": "token:radius.md"
        },
        "figcaption": {
            "fontSize": "token:text.xs",
            "color": "token:color.muted"
        }
    },
    "buttons": {
        "primary": {
            "base": {
                "borderRadius": "token:radius.md",
                "fontWeight": 500,
                "letterSpacing": "-0.006em",
                "transition": "background-color 160ms ease",
                "backgroundColor": "token:color.yellow",
                "color": "token:color.on-yellow"
            },
            "hover": {
                "backgroundColor": "#f5d800"
            }
        },
        "secondary": {
            "base": {
                "borderRadius": "token:radius.md",
                "fontWeight": 500,
                "letterSpacing": "-0.006em",
                "transition": "background-color 160ms ease",
                "backgroundColor": "token:color.panel",
                "color": "token:color.ink",
                "borderColor": "transparent"
            },
            "hover": {
                "backgroundColor": "token:color.panel-hover"
            }
        },
        "ghost": {
            "base": {
                "borderRadius": "token:radius.md",
                "fontWeight": 500,
                "letterSpacing": "-0.006em",
                "transition": "background-color 160ms ease",
                "backgroundColor": "transparent",
                "color": "token:color.muted",
                "borderColor": "transparent"
            },
            "hover": {
                "color": "token:color.ink",
                "backgroundColor": "token:color.panel"
            }
        },
        "yellow": {
            "base": {
                "borderRadius": "token:radius.md",
                "fontWeight": 500,
                "letterSpacing": "-0.006em",
                "transition": "background-color 160ms ease",
                "backgroundColor": "token:color.yellow",
                "color": "token:color.on-yellow"
            },
            "hover": {
                "backgroundColor": "#f5d800"
            }
        }
    },
    "transition": {
        "type": "none",
        "duration": 0.2
    }
}
