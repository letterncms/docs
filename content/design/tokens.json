            "normal": {
                "$value": "-0.006em"
            },
            "caps": {
                "$value": "0.08em"
            },
            "mono": {
                "$value": "-0.01em"
            }
        },
        "weight": {
            "regular": {
                "$value": "400"
            },
            "medium": {
                "$value": "500"
            },
            "semibold": {
                "$value": "600"
            },
            "heading": {
                "$value": "450"
            }
        },
        "space": {
            "$type": "dimension",
            "0": {
                "$value": "0"
            },
            "1": {
                "$value": "0.25rem"
            },
            "2": {
                "$value": "0.5rem"
            },
